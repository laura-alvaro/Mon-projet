 "structures": [
  {
   "id": "pas-seulement",
   "regex": "(?i)\\bce n'?est pas (?:seulement|juste|que|uniquement) [^.!?\\n]{2,60}[,.] c'?est\\b",
   "name": "« Ce n'est pas seulement X, c'est Y »",
   "fix": "Dis directement Y. La fausse opposition sonne IA."
  },
  {
   "id": "non-seulement",
   "regex": "(?i)\\bnon seulement\\b[^.!?\\n]{2,80}\\bmais (?:aussi|également)\\b",
   "name": "« Non seulement… mais aussi… »",
   "fix": "Fais deux phrases, ou garde la plus forte."
  },
  {
   "id": "il-ne-sagit-pas",
   "regex": "(?i)\\bil ne s'?agit pas (?:de|d')[^.!?\\n]{2,60}[,.] il s'?agit\\b",
   "name": "« Il ne s'agit pas de X, il s'agit de Y »",
   "fix": "Commence par Y."
  },
  {
   "id": "reveal",
   "regex": "(?i)^\\s*(?:le résultat|la cerise sur le gâteau|le petit plus|le bonus|le secret|la vérité)\\s*\\?\\s*$",
   "name": "Question-révélation sur une ligne (« Le résultat ? »)",
   "fix": "Donne l'info directement dans la phrase."
  },
  {
   "id": "triade",
   "regex": "(?i)\\b\\w+, \\w+ et \\w+\\.",
   "name": "Liste de 3 (« lumineux, spacieux et moderne. »)",
   "fix": "Mets 2 éléments ou un fait chiffré. Le rythme par 3 est le réflexe de l'IA."
  },
  {
   "id": "que-vous-soyez",
   "regex": "(?i)\\bque (?:vous soyez|tu sois)\\b[^.!?\\n]{2,80}\\bou\\b",
   "name": "« Que vous soyez X ou Y »",
   "fix": "Parle à une seule personne précise."
  },
  {
   "id": "nhesitez",
   "regex": "(?i)\\bn'?h[ée]sit(?:ez|e) pas\\b",
   "name": "« N'hésitez pas à… »",
   "fix": "Donne l'action directement : « Écrivez-moi VISITE », « Appelez-moi au … »."
  },
  {
   "id": "saviez-vous",
   "regex": "(?i)\\ble saviez-vous\\b|\\ble savais-tu\\b",
   "name": "« Le saviez-vous ? »",
   "fix": "Balance l'info, sans la question d'intro."
  },
  {
   "id": "video-preamble",
   "regex": "(?i)\\bdans (?:cette|la) vidéo\\b|\\baujourd'?hui,? (?:je vais|on va) (?:vous|te) (?:montrer|parler)\\b",
   "name": "Préambule vidéo",
   "fix": "Commence par le fait le plus fort, pas par l'annonce de la vidéo."
  },
  {
   "id": "vous-revez",
   "regex": "(?i)^\\s*(?:vous rêvez|tu rêves|imaginez|imagine)\\b",
   "name": "Ouverture « Vous rêvez de… / Imaginez… »",
   "fix": "Commence par un fait : prix, m², quartier, détail visible."
  },
  {
   "id": "adjectifs-annonce",
   "regex": "(?i)\\b(?:sublimes?|exceptionnel(?:le)?s?|incontournables?|joyau|pépites?|perle rare|cocon|écrin|charmant(?:e)?s?|magnifiques?|idylliques?|prestigieu(?:x|se|ses))\\b",
   "name": "Adjectif d'annonce cliché",
   "fix": "Remplace par un fait concret : m², exposition, vue, année, distance à pied, montant des charges."
  },
  {
   "id": "au-coeur",
   "regex": "(?i)\\bau c(?:œ|oe)ur d(?:e|u|es|')",
   "name": "« Au cœur de… »",
   "fix": "Dis où exactement : « à 3 min à pied de la place du marché »."
  },
  {
   "id": "bait",
   "regex": "(?i)\\b(?:abonnez-vous|abonne-toi|identifie(?:z)? (?:quelqu'un|une personne|un ami)|double[- ]tap|like si|partage(?:z)? si)\\b",
   "name": "Appel réflexe (abonne-toi, identifie…)",
   "fix": "Une seule demande utile par post, liée au bien : « Commente VISITE »."
  },
  {
   "id": "emoji-bullets",
   "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅✔✨➡⭐]️?\\s+\\S",
   "name": "Liste à puces en emojis",
   "fix": "Garde 1 ou 2 emojis max dans le texte, pas un par ligne."
  },
  {
   "id": "hashtag-wall",
   "regex": "(?:#\\w+\\s*){6,}",
   "name": "Mur de hashtags",
   "fix": "3 à 5 hashtags précis (ville, quartier, type de bien)."
  },
  {
   "id": "shouting",
   "regex": "\\b[A-ZÀ-Ý]{3,}\\s+[A-ZÀ-Ý]{3,}\\s+[A-ZÀ-Ý]{3,}\\b",
   "name": "3 mots en majuscules d'affilée",
   "fix": "Un seul mot en majuscules maximum (ex. le mot-clé VISITE)."
  }
 ]
}