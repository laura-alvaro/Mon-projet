# Copiez ce fichier en .env et remplissez ce dont vous avez besoin.
# Seul APP_PASSWORD est indispensable dès que l'appli est en ligne.

PORT=3000
APP_URL=http://localhost:3000
APP_PASSWORD=choisissez-un-mot-de-passe-solide

# --- Gmail & Google Agenda (optionnel) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMS & WhatsApp 100 % automatiques via Twilio (optionnel) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
